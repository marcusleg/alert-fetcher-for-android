<?xml version="1.0" encoding="utf-8"?>
<!-- Homelab Alertmanager instances commonly run over plain HTTP on the LAN or a VPN,
     so cleartext is permitted for the outgoing silence API calls. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <!-- Allows private CAs installed by the user (common in homelabs). -->
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
